        end

        subgraph AUTH["Auth Service :8001"]
            AuthAPI["FastAPI<br/>JWT-авторизация<br/>Роли: Player / Coach / Admin"]
        end

        subgraph CORE["Core Service :8002"]
            CoreAPI["FastAPI<br/>Профили игроков и тренеров<br/>Steam-привязка<br/>Прокси к ML/LLM"]
