        end

        subgraph LLM["LLM Service :8004"]
            LLMAPI["FastAPI<br/>AI-советы (заглушка)<br/>Контекст: feature gaps"]
        end

        subgraph DB["PostgreSQL :5432"]
            PG[("База данных<br/>users, profiles<br/>ml_kaggle_baselines<br/>player_accounts<br/>player_matches<br/>ml_player_analyses")]
        end
    end

    subgraph EXT["Внешние источники"]
        OD["OpenDota API<br/>Профиль, матчи<br/>Totals, Rankings<br/>Парсинг матчей"]
        KG["Kaggle Dataset<br/>594K записей<br/>Pro League 2024-2025"]
    end

