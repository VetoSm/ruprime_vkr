{
  "$schema": "https://design-tokens.github.io/community-group/format/",
  "$description": "RuPrime design tokens. Source of truth: services/frontend/src/ui/theme.css. Synced 2026-05-21.",

  "color": {
    "bg": {
      "primary":      { "$value": "#040b1f", "$type": "color", "$description": "Main app background, top of gradient" },
      "secondary":    { "$value": "#081530", "$type": "color", "$description": "Sidebar, secondary surfaces" },
      "card":         { "$value": "#0c1b3b", "$type": "color", "$description": "Card / panel background" },
      "card-hover":   { "$value": "#10244a", "$type": "color" },
      "input":        { "$value": "#09142b", "$type": "color" },
      "overlay":      { "$value": "rgba(10, 14, 26, 0.9)", "$type": "color" }
    },
    "border": {
      "subtle":   { "$value": "#183563", "$type": "color" },
      "accent":   { "$value": "#16e9d4", "$type": "color" },
      "glow":     { "$value": "rgba(22, 233, 212, 0.35)", "$type": "color" }
    },
    "text": {
      "primary":   { "$value": "#e8edf5", "$type": "color" },
      "secondary": { "$value": "#7b8ba5", "$type": "color" },
      "muted":     { "$value": "#4a5568", "$type": "color" }
    },
    "accent": {
      "cyan":        { "$value": "#16e9d4", "$type": "color", "$description": "Primary brand accent" },
      "cyan-dim":    { "$value": "#12cbbb", "$type": "color" },
      "cyan-bright": { "$value": "#4df7e5", "$type": "color" },
      "cyan-bg":     { "$value": "rgba(22, 233, 212, 0.1)", "$type": "color" },
      "cyan-glow":   { "$value": "rgba(22, 233, 212, 0.3)", "$type": "color" }
    },
    "purple": {
      "base":  { "$value": "#7d5eff", "$type": "color", "$description": "Secondary accent, primary CTA gradient start" },
      "bg":    { "$value": "rgba(125, 94, 255, 0.14)", "$type": "color" },
      "glow":  { "$value": "rgba(125, 94, 255, 0.32)", "$type": "color" }
    },
    "status": {
      "danger":      { "$value": "#ff4757", "$type": "color" },
      "danger-bg":   { "$value": "rgba(255, 71, 87, 0.08)", "$type": "color" },
      "warning":     { "$value": "#ffa502", "$type": "color" },
      "warning-bg":  { "$value": "rgba(255, 165, 2, 0.08)", "$type": "color" },
      "success":     { "$value": "#00d4aa", "$type": "color" },
      "success-bg":  { "$value": "rgba(0, 212, 170, 0.08)", "$type": "color" }
    },
    "rank": {
      "herald":   { "$value": "#8b8b8b", "$type": "color" },
      "guardian": { "$value": "#b0c4de", "$type": "color" },
      "crusader": { "$value": "#90ee90", "$type": "color" },
      "archon":   { "$value": "#f0e68c", "$type": "color" },
      "legend":   { "$value": "#ffd700", "$type": "color" },
      "ancient":  { "$value": "#ff8c00", "$type": "color" },
      "divine":   { "$value": "#ff69b4", "$type": "color" },
      "immortal": { "$value": "#ff4444", "$type": "color" }
    }
  },

  "font": {
    "family": {
      "display": { "$value": "'Rajdhani', 'Inter', sans-serif", "$type": "fontFamily", "$description": "Headings, hero titles, logo, sidebar logo" },
      "body":    { "$value": "'Inter', -apple-system, BlinkMacSystemFont, 'Segoe UI', sans-serif", "$type": "fontFamily" }
    },
    "weight": {
      "regular":  { "$value": 400, "$type": "fontWeight" },
      "medium":   { "$value": 500, "$type": "fontWeight" },
      "semibold": { "$value": 600, "$type": "fontWeight" },
      "bold":     { "$value": 700, "$type": "fontWeight" },
      "extra":    { "$value": 800, "$type": "fontWeight" },
      "black":    { "$value": 900, "$type": "fontWeight" }
    },
    "size": {
      "xs":   { "$value": "0.72rem",  "$type": "dimension", "$description": "labels, sublabels" },
      "sm":   { "$value": "0.82rem",  "$type": "dimension" },
      "base": { "$value": "0.92rem",  "$type": "dimension" },
      "md":   { "$value": "1.05rem",  "$type": "dimension" },
      "lg":   { "$value": "1.4rem",   "$type": "dimension" },
      "xl":   { "$value": "1.8rem",   "$type": "dimension", "$description": "Page H1" },
      "2xl":  { "$value": "2.4rem",   "$type": "dimension" },
      "hero": { "$value": "clamp(2rem, 3.4vw, 3.2rem)", "$type": "dimension", "$description": "Landing hero" }
    },
    "letter-spacing": {
      "tight":   { "$value": "-0.9px", "$type": "dimension", "$description": "Hero titles" },
      "label":   { "$value": "0.5px",  "$type": "dimension" },
      "wide":    { "$value": "0.8px",  "$type": "dimension", "$description": "UPPERCASE labels (stat-card-label, form-group label)" }
    }
  },

  "radius": {
    "sm": { "$value": "8px",  "$type": "dimension" },
    "md": { "$value": "10px", "$type": "dimension" },
    "lg": { "$value": "14px", "$type": "dimension" },
    "xl": { "$value": "20px", "$type": "dimension" },
    "pill": { "$value": "999px", "$type": "dimension" }
  },

  "spacing": {
    "xs":  { "$value": "4px",  "$type": "dimension" },
    "sm":  { "$value": "8px",  "$type": "dimension" },
    "md":  { "$value": "12px", "$type": "dimension" },
    "lg":  { "$value": "16px", "$type": "dimension" },
    "xl":  { "$value": "20px", "$type": "dimension" },
    "2xl": { "$value": "28px", "$type": "dimension" },
    "3xl": { "$value": "40px", "$type": "dimension" }
  },

  "shadow": {
    "card":    { "$value": "0 4px 20px rgba(0, 0, 0, 0.4)", "$type": "shadow" },
    "glow":    { "$value": "0 0 30px rgba(0, 212, 170, 0.08)", "$type": "shadow" },
    "accent":  { "$value": "0 0 18px rgba(22, 233, 212, 0.24)", "$type": "shadow" },
    "purple":  { "$value": "0 4px 18px rgba(125, 94, 255, 0.28)", "$type": "shadow" }
  },

  "motion": {
    "transition": { "$value": "all 0.25s cubic-bezier(0.4, 0, 0.2, 1)", "$type": "transition" }
  },

  "layout": {
    "sidebar-width":           { "$value": "260px", "$type": "dimension" },
    "sidebar-collapsed-width": { "$value": "64px",  "$type": "dimension" },
    "topbar-height":           { "$value": "52px",  "$type": "dimension" },
    "container-max":           { "$value": "1180px","$type": "dimension" }
  }
}
