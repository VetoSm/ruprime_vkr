# Copy to `.env` and fill in real values before running docker compose up.
# The same file must be present on the server.

# ===== PostgreSQL =====
POSTGRES_USER=dota_coach
POSTGRES_PASSWORD=change-me-strong
POSTGRES_DB=dota_coach_db
POSTGRES_HOST=postgres
POSTGRES_PORT=5432
DATABASE_URL=postgresql://dota_coach:change-me-strong@postgres:5432/dota_coach_db

# ===== Test data seed (true only on first boot, then back to false) =====
SEED_TEST_DATA=false

# ===== JWT (required, no default secret) =====
JWT_SECRET=change-me-to-long-random-string
JWT_ALGORITHM=HS256
JWT_ACCESS_EXPIRES_MIN=30
JWT_REFRESH_EXPIRES_DAYS=30

# Set to `true` once to force-logout all users after a security update,
# then set back to `false` and restart auth. Values: true|false.
FORCE_REVOKE_ALL_SESSIONS=false

# ===== Internal ML token =====
# Must match for `core` and `ml`. Never expose this value to the frontend.
ML_INTERNAL_TOKEN=change-me-to-long-random-string

# ===== Internal service URLs =====
AUTH_SERVICE_URL=http://auth:8001
CORE_SERVICE_URL=http://core:8002
ML_SERVICE_URL=http://ml:8003
LLM_SERVICE_URL=http://llm:8004

# ===== Steam OpenID =====
STEAM_OPENID_ENABLED=true
STEAM_RETURN_URL=http://localhost:8001/auth/steam/callback
STEAM_REALM=http://localhost:8001/
FRONTEND_STEAM_REDIRECT=http://localhost:3000/auth/steam-callback

# ===== Data =====
KAGGLE_DATA_PATH=/data/archive-2

# ===== CORS (comma-separated, no spaces) =====
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# ===== Frontend build-time env =====
VITE_AUTH_API_URL=http://localhost:8001
VITE_CORE_API_URL=http://localhost:8002
# Note: VITE_ML_API_URL is intentionally absent. ML is internal-only.
